# .env.local template — copy to .env.local and fill in the values.
#
# Usage:
#   1. cp .env.example .env.local
#   2. Replace <fill-from-yapi> with the actual YAPI token for your project.
#   3. .env.local is in .gitignore, so it never gets committed.

# YAPI_TOKEN — yapi-to-typescript pulls API specs from YAPI (category
# {{YAPI_CATEGORY}} per ytt.config.ts).
YAPI_TOKEN=<fill-from-yapi>

# UMI_APP_ARMS_ENDPOINT — ARMS RUM monitoring endpoint.
# Format:
#   https://proj-xtrace-<id>.<region>.log.aliyuncs.com/rum/web/v2?workspace=<workspace>&service_id=<service-id>
# How to get it: Aliyun ARMS console → workspace → Browser monitoring →
# Access Settings → copy endpoint.
# Empty → src/services/arms.ts skips init, falls back to console-only
# logging (fork-safe default — a fresh fork won't accidentally report into
# someone else's workspace). Each sub-app uses its own service_id so events
# stream into the right ARMS workspace.
UMI_APP_ARMS_ENDPOINT=
