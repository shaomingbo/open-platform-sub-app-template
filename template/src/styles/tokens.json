      "row-hover": { "$value": "#fafafa", "$type": "color" },
      "menu-hover": { "$value": "#f5f5f5", "$type": "color" },
      "tooltip-spotlight": { "$value": "#171717", "$type": "color" },
      "tooltip-text": { "$value": "#ffffff", "$type": "color" },
      "success": { "$value": "#10b981", "$type": "color" },
      "warning": { "$value": "#f59e0b", "$type": "color" },
      "error": { "$value": "#ef4444", "$type": "color" },
      "info": { "$value": "#0072f5", "$type": "color" },
      "link": { "$value": "#0072f5", "$type": "color" }
    },
    "status": {
      "online": { "$value": "#10b981", "$type": "color" },
