      "error": { "$value": "rgba(239, 68, 68, 0.2)", "$type": "color" },
      "pending": { "$value": "rgba(0, 114, 245, 0.18)", "$type": "color" },
      "warning": { "$value": "rgba(245, 158, 11, 0.18)", "$type": "color" },
      "neutral": { "$value": "transparent", "$type": "color" }
    },
    "shadow": {
      "hairline": {
        "$value": "rgba(0, 0, 0, 0.08) 0px 0px 0px 1px",
        "$type": "shadow"
      },
      "card": {
        "$value": "rgba(0, 0, 0, 0.08) 0px 0px 0px 1px, rgba(0, 0, 0, 0.04) 0px 2px 2px, rgba(0, 0, 0, 0.04) 0px 8px 8px -8px, #fafafa 0px 0px 0px 1px inset",
        "$type": "shadow"
      },
      "focus-ring": {
        "$value": "0 0 0 3px hsla(212, 100%, 48%, 0.24)",
        "$type": "shadow"
      },
      "kbd-bottom": {
        "$value": "0 1px 0 rgba(0, 0, 0, 0.04)",
        "$type": "shadow",
        "$description": "KbdShortcut kbd 凸起感 — 底部 1px 微阴影. design intent: 让 keyboard hint 像物理按键略凸起."
      }
    }
  },

