      },
      "card": {
        "$value": "rgba(255, 255, 255, 0.06) 0px 0px 0px 1px, rgba(0, 0, 0, 0.4) 0px 2px 2px, rgba(0, 0, 0, 0.5) 0px 8px 8px -8px, rgba(255, 255, 255, 0.02) 0px 0px 0px 1px inset",
