      "bg": { "$value": "#0a0a0a", "$type": "color" },
      "bg-layout": { "$value": "#050505", "$type": "color" },
      "bg-elevated": { "$value": "#0f0f0f", "$type": "color" },
      "bg-subtle": { "$value": "#1a1a1a", "$type": "color" },
      "text-heading": { "$value": "#fafafa", "$type": "color" },
      "text-body": { "$value": "#d4d4d4", "$type": "color" },
      "text-meta": { "$value": "#a3a3a3", "$type": "color" },
      "text-disabled": { "$value": "#737373", "$type": "color" },
      "border": { "$value": "#262626", "$type": "color" },
      "border-soft": { "$value": "#1f1f1f", "$type": "color" },
      "cta-primary": { "$value": "#fafafa", "$type": "color" },
      "cta-primary-hover": { "$value": "#ffffff", "$type": "color" },
      "cta-primary-active": { "$value": "#d4d4d4", "$type": "color" },
      "cta-text": { "$value": "#0a0a0a", "$type": "color" },
      "default-border-hover": { "$value": "#3f3f3f", "$type": "color" },
      "default-border-active": { "$value": "#525252", "$type": "color" },
      "row-hover": { "$value": "#141414", "$type": "color" },
      "menu-hover": { "$value": "#1f1f1f", "$type": "color" },
      "tooltip-spotlight": { "$value": "#fafafa", "$type": "color" },
      "tooltip-text": { "$value": "#0a0a0a", "$type": "color" },
      "success": { "$value": "#34d399", "$type": "color" },
